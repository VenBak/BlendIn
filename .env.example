# Required: your MongoDB Atlas connection string (Atlas > Connect > Drivers).
# Put the database name after the host, e.g. ...mongodb.net/blendin?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://USER:PASSWORD@your-cluster.xxxxx.mongodb.net/blendin?retryWrites=true&w=majority

# Required in production: a long random string that signs login sessions.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me

# The account that signs up (or logs in) with this email becomes the admin,
# who can add cities and appoint city moderators.
ADMIN_EMAIL=you@example.com

# Optional
PORT=3000
SEED_DEMO=true                      # adds the Dutch demo cities when the database is empty

# Payments. Leave empty for demo mode (purchases are free and instant).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Maps. Defaults: OpenStreetMap tiles and the public OpenStreetMap foot router.
# Both are for light use; set your own provider for real traffic.
TILE_URL=
TILE_ATTRIBUTION=
ROUTING_URL=
